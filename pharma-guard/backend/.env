# Flask Configuration
FLASK_APP=app.main
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/pharmaguard

# Blockchain Configuration
ALGORAND_NODE_URL=https://testnet-api.algorand.network
ALGORAND_INDEXER_URL=https://testnet-idx.algorand.network
ALGORAND_WALLET_MNEMONIC=your-wallet-mnemonic-here
CONTRACT_ADDRESS=your-contract-address-here

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL=gpt-4

# Application Configuration
LOG_LEVEL=INFO
ENABLE_BLOCKCHAIN_VERIFICATION=true
MERKLE_TREE_DEPTH=20
